{
  "appId": "com.yourcompany.gcash-pos",
  "productName": "GCash POS",
  "directories": {
    "buildResources": "build",
    "output": "dist"
  },
  "files": [
    "src/**/*",
    "package.json"
  ],
  "win": {
    "target": ["nsis"],
    "icon": "build/icons/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": true
  }
}
