{
  "name": "gcash-pos",
  "productName": "GCash POS",
  "version": "0.1.0",
  "description": "Hybrid Offline+Online GCash-style POS Transaction Record System built with Electron",
  "main": "src/main/main.js",
  "author": "Your Name",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "build": "electron-builder --win --x64",
    "dist": "electron-builder"
  },
  "dependencies": {
    "axios": "^1.4.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^8.1.0",
    "chart.js": "^4.4.0",
    "dayjs": "^1.11.9",
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.0",
    "electron": "^25.0.0",
    "electron-builder": "^24.7.0",
    "electron-rebuild": "^3.2.9",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.0.0"
  },
  "build": {
    "extends": null,
    "appId": "com.yourcompany.gcash-pos",
    "productName": "GCash POS",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icons/icon.ico"
    }
  }
}
