{
  "appId": "com.cashpos.desktop",
  "productName": "CashPOS",
  "directories": {
    "buildResources": "build",
    "output": "dist"
  },
  "files": [
    "src/**/*",
    "package.json"
  ],
  "publish": [
    {
      "provider": "github",
      "owner": "kumaru06",
      "repo": "gcashpos"
    }
  ],
  "win": {
    "target": ["nsis"],
    "icon": "build/icons/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": true
  }
}
