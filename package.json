{
  "name": "cashpos",
  "productName": "CashPOS",
  "version": "0.1.0",
  "description": "Hybrid offline + online POS transaction record system built with Electron",
  "main": "src/main/main.js",
  "author": "kumaru06",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kumaru06/gcashpos.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "build": "node scripts/generate-icon.js && electron-builder --win --x64",
    "build:publish": "node scripts/generate-icon.js && electron-builder --win --x64 --publish always",
    "dist": "electron-builder"
  },
  "dependencies": {
    "axios": "^1.4.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^8.1.0",
    "chart.js": "^4.4.0",
    "dayjs": "^1.11.9",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.9",
    "nodemailer": "^8.0.7"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.0",
    "electron": "^25.0.0",
    "electron-builder": "^24.7.0",
    "electron-rebuild": "^3.2.9",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.0.0"
  },
  "build": {
    "extends": null,
    "appId": "com.cashpos.desktop",
    "productName": "CashPOS",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "kumaru06",
        "repo": "gcashpos",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "guid": "6244FF17-A249-5A52-8228-68B29EE13031",
      "shortcutName": "CashPOS",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false
    }
  }
}
